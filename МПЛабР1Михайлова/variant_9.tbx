        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>устойчивое экономическое развитие</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
