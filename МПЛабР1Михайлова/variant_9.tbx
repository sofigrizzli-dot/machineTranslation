        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>sustainable economic development</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Economic growth achieved without depleting natural resources or harming the environment.</descrip>
          </tig>
