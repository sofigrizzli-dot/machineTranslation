              <term>электромобиль</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-092">
        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>sustainable aviation fuel</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A fuel used to power aircraft that has a lower carbon footprint than conventional jet fuel.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>экологически чистое авиационное топливо</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-093">
        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>supportive policy framework</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A set of regulations and policies designed to encourage and facilitate investment in a sector.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>благоприятная нормативная база</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-094">
        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>domestic supply chains</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The network of suppliers and production processes located within a country's borders.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>внутренние цепочки поставок</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-095">
        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>hybridisation of projects</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The integration of two or more energy sources or technologies, such as solar and storage, in one project.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>гибридизация проектов</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-096">
        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>process heating</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The use of heat in industrial processes such as manufacturing, chemical production, or food processing.</descrip>
          </tig>
