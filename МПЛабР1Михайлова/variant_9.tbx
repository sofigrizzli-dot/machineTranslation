        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>hybrid mini-grids</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A small independent grid combining multiple energy sources, such as solar and batteries, with backup.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>гибридные мини-сети</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
