        <langSet xml:lang="en">
          <tig>
            <term>battery energy storage</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Rechargeable battery systems used to store electrical energy for later use and grid balancing.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
