        <langSet xml:lang="en">
          <tig>
            <term>distributed renewable energy</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Small-scale renewable systems installed close to the point of use rather than at a central plant.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>распределенная возобновляемая энергетика</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
