        <langSet xml:lang="en">
          <tig>
            <term>commercially available technologies</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Technologies that are fully developed, market-ready, and available for purchase and deployment.</descrip>
