        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>технологический нагрев</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-097">
        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>targeted financing</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Financial resources specifically allocated for a particular project, purpose, or sector.</descrip>
