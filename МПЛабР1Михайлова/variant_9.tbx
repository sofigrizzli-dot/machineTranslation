        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>целевое финансирование</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-098">
        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>renewable energy targets</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Specific and measurable goals for the adoption or generation of renewable energy.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>целевые показатели в области возобновляемой энергетики</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-099">
        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>economics of electricity generation</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The financial factors that determine the cost, price, and viability of generating electricity.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>экономика производства электроэнергии</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-100">
        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>insulation from shocks</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The ability of a system or economy to resist and recover from external shocks such as price volatility.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>защищенность от потрясений</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
    </body>
  </text>
</martif>
