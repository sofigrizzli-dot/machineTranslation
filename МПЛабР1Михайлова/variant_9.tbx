        <langSet xml:lang="en">
          <tig>
            <term>manufacture and deployment</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The combined activities of manufacturing, selling, and installing technology systems.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>производство и внедрение</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
