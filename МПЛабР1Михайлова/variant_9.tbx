        <langSet xml:lang="en">
          <tig>
            <term>ambition</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The level of commitment or stringency of a target set by a government or organization.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>амбиции</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
