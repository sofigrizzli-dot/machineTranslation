        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>renewables-based heating</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Heating systems that use renewable sources such as solar thermal, geothermal, or biomass.</descrip>
          </tig>
