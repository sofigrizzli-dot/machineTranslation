        <descrip type="subjectField">Возобновляемая энергетика и накопители энергии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>electric vehicle</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A vehicle propelled by one or more electric motors using energy stored in rechargeable batteries.</descrip>
          </tig>
