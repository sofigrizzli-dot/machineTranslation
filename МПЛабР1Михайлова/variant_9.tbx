        <langSet xml:lang="en">
          <tig>
            <term>least-cost source</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The lowest possible cost of producing a good or service, used to compare energy sources.</descrip>
          </tig>
        </langSet>
