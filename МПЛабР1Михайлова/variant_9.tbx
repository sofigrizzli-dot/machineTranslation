        <langSet xml:lang="en">
          <tig>
            <term>grid enhancement</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Upgrading and improving the capacity, efficiency, and flexibility of existing electricity grids.</descrip>
          </tig>
